cabal-version:      3.0
name:               typecloud

-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

license:            Apache-2.0
license-file:       LICENSE
author:             Satya Jhaveri
build-type:         Simple

common shared
    default-language: GHC2021
    ghc-options:      -Wall -Wno-name-shadowing
    build-depends:    base >=4.16 && <5

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  TC.Net
    build-depends:    aeson, containers, text, time

executable tc-server
    import: shared
    hs-source-dirs: app
    main-is:          Server.hs
    build-depends: typecloud

executable tc-agent
    import: shared
    hs-source-dirs: app
    main-is: Agent.hs
    build-depends: typecloud


executable tc
    import: shared
    hs-source-dirs: app
    main-is: Cli.hs
    build-depends: typecloud

executable tc-objstore
    import: shared
    hs-source-dirs: app
    main-is: ObjStore.hs
    build-depends: typecloud

test-suite spec
    import: shared
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    build-depends: typecloud
